@inject IDataProvider DataProvider
@inject RefreshService RefreshService
@inject SessionTokenStore TokenStore
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@implements IDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.TeamFoundation.SourceControl.WebApi
@using Microsoft.TeamFoundation.WorkItemTracking.WebApi
@using Microsoft.VisualStudio.Services.Common
@using Microsoft.VisualStudio.Services.WebApi

<PageTitle>Nexus</PageTitle>

@if (!_loaded)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:60vh;">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
    </MudStack>
}
else if (!_hasAccounts)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Style="height:60vh;">
        <MudIcon Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.NoAccounts" Style="font-size:120px; opacity:0.6;" />
        <MudText Typo="Typo.h6" Style="opacity:0.6;">No accounts added yet</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@OnOpenSettings">Add account</MudButton>
    </MudStack>
}
else
{
    <div style="padding:16px;max-width:1600px;margin:0 auto;">
        <MudGrid Spacing="4" Style="margin-bottom:24px;">
            <MudItem xs="6" md="3">
                <MetricCard Count="@_workItems.Count(wi => wi.Assignee != null)" Label="work items assigned to you"
                            Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.AssignmentInd" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MetricCard Count="@_workItems.Count(wi => wi.Assignee == null)" Label="unassigned work items"
                            Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.AssignmentLate" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MetricCard Count="@_pullRequests.Count(pr => pr.IsAssignedToCurrentUser)" Label="PRs assigned to you"
                            Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.PersonEdit" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MetricCard Count="@_pullRequests.Count(pr => !pr.IsAssignedToCurrentUser)" Label="unassigned PRs"
                            Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.RebaseEdit" />
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="4">
            <MudItem xs="12" lg="6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                          Style="margin-bottom:4px;">
                    <MudText Typo="Typo.h5">Work Items</MudText>
                    <div style="width:220px;">
                        <MudTextField T="string" @bind-Value="_workItemSearch" Placeholder="Search..."
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Immediate="true" />
                    </div>
                </MudStack>
                <WorkItemList Items="_workItems" SearchTerm="@_workItemSearch"
                             AssignedItemIds="@_assignedWorkItemIds"
                             FetchDetails="@FetchWorkItemDetailsAsync" />
            </MudItem>
            <MudItem xs="12" lg="6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                          Style="margin-bottom:4px;">
                    <MudText Typo="Typo.h5">Pull Requests</MudText>
                    <div style="width:220px;">
                        <MudTextField T="string" @bind-Value="_prSearch" Placeholder="Search..." Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable="true" Immediate="true" />
                    </div>
                </MudStack>
                <PullRequestList Items="_pullRequests" SearchTerm="@_prSearch"
                                AssignedPrIds="@_assignedPrIds"
                                FetchDescription="@FetchPrDescriptionAsync"
                                AssignReviewer="@AssignSelfAsReviewerAsync" />
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    private bool _loaded;
    private bool _hasAccounts;
    private IEnumerable<WorkItem> _workItems = [];
    private IEnumerable<PullRequest> _pullRequests = [];

    private HashSet<string> _assignedWorkItemIds = [];
    private HashSet<string> _assignedPrIds = [];

    private string? _workItemSearch;
    private string? _prSearch;

    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        TokenStore.AccountsChanged += OnAccountsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await TokenStore.LoadAsync();
        await RefreshAsync();
        _loaded = true;
        StateHasChanged();
        _ = RunRefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshAsync()
    {
        _hasAccounts = TokenStore.GetLinkedAccounts() is { } accounts
            && (accounts.GitHubAccounts.Count > 0 || accounts.MicrosoftAccounts.Count > 0);
        var data = await DataProvider.GetDashboardDataAsync();
        _workItems = data.WorkItems.OrderBy(wi => wi.Assignee == null).ThenByDescending(wi => wi.UpdatedAt);
        _pullRequests = data.PullRequests;
        _assignedWorkItemIds = _workItems.Where(wi => wi.Assignee != null).Select(x => x.Id).ToHashSet();
        _assignedPrIds = _pullRequests.Where(pr => pr.IsAssignedToCurrentUser || pr.WasCreatedByCurrentUser).Select(x => x.Id).ToHashSet();
        RefreshService.NotifyRefreshed();
    }

    private void OnAccountsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task RunRefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        while (await timer.WaitForNextTickAsync(ct))
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<WorkItemDetails?> FetchWorkItemDetailsAsync(WorkItem wi)
    {
        if (wi.Url is not { } url) return null;
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)) return null;

        if (uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase))
            return await FetchGitHubIssueDetailsAsync(uri);

        var path = uri.AbsolutePath.TrimStart('/');
        var wiIdx = path.IndexOf("/_workitems/edit/", StringComparison.Ordinal);
        if (wiIdx < 0) return null;

        var beforeWi = path[..wiIdx];
        var afterEdit = path[(wiIdx + "/_workitems/edit/".Length)..];
        if (!int.TryParse(afterEdit.Split('/')[0], out var wiId)) return null;

        string orgUrl, projectName;
        if (uri.Host.Equals("dev.azure.com", StringComparison.OrdinalIgnoreCase))
        {
            var slashIdx = beforeWi.IndexOf('/');
            if (slashIdx < 0) return null;
            orgUrl = $"{uri.Scheme}://dev.azure.com/{beforeWi[..slashIdx]}";
            projectName = Uri.UnescapeDataString(beforeWi[(slashIdx + 1)..]);
        }
        else
        {
            orgUrl = $"{uri.Scheme}://{uri.Host}";
            projectName = Uri.UnescapeDataString(beforeWi);
        }

        var token = TokenStore.GetLinkedAccounts().MicrosoftAccounts
            .FirstOrDefault(a => string.Equals(
                a.OrgUrl.TrimEnd('/'), orgUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase));
        if (token is null) return null;

        try
        {
            var connection = new VssConnection(new Uri(orgUrl), new VssBasicCredential(string.Empty, token.PersonalAccessToken));
            var client = await connection.GetClientAsync<WorkItemTrackingHttpClient>();

            string[] fields = [
                "Microsoft.VSTS.Common.AcceptanceCriteria",
                "Microsoft.VSTS.Common.Priority",
                "System.IterationPath",
                "System.AreaPath",
                "Microsoft.VSTS.Scheduling.StoryPoints",
                "Microsoft.VSTS.Scheduling.Effort",
                "Microsoft.VSTS.Scheduling.RemainingWork",
                "System.Parent",
            ];

            var item = await client.GetWorkItemAsync(wiId, fields);
            string? Get(string field) => item.Fields.TryGetValue(field, out var v) ? v?.ToString() : null;

            var storyPoints = Get("Microsoft.VSTS.Scheduling.StoryPoints");
            var effort = Get("Microsoft.VSTS.Scheduling.Effort");
            var effortDisplay = storyPoints is not null ? $"{storyPoints} pts"
                              : effort is not null ? $"{effort} h"
                              : null;

            var remainingWork = Get("Microsoft.VSTS.Scheduling.RemainingWork");

            var parentId = Get("System.Parent");
            var parentUrl = parentId is not null
                ? $"{orgUrl.TrimEnd('/')}/{Uri.EscapeDataString(projectName)}/_workitems/edit/{parentId}"
                : null;

            return new WorkItemDetails(
                AcceptanceCriteria: Get("Microsoft.VSTS.Common.AcceptanceCriteria"),
                Priority: Get("Microsoft.VSTS.Common.Priority"),
                IterationPath: Get("System.IterationPath"),
                AreaPath: Get("System.AreaPath"),
                Effort: effortDisplay,
                RemainingWork: remainingWork is not null ? $"{remainingWork} h" : null,
                ParentId: parentId,
                ParentUrl: parentUrl);
        }
        catch
        {
            return null;
        }
    }

    private async Task<WorkItemDetails?> FetchGitHubIssueDetailsAsync(Uri uri)
    {
        var segments = uri.AbsolutePath.Trim('/').Split('/');
        if (segments.Length < 4 || !segments[2].Equals("issues", StringComparison.OrdinalIgnoreCase)) return null;
        if (!int.TryParse(segments[3], out var number)) return null;
        var owner = segments[0];
        var repo = segments[1];

        var ghToken = TokenStore.GetLinkedAccounts().GitHubAccounts
            .FirstOrDefault(a => a.MonitoredRepos.Any(r =>
                r.Equals($"{owner}/{repo}", StringComparison.OrdinalIgnoreCase)))
            ?? TokenStore.GetLinkedAccounts().GitHubAccounts.FirstOrDefault();
        if (ghToken is null) return null;

        try
        {
            var client = HttpClientFactory.CreateClient("GitHub");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", ghToken.PersonalAccessToken);

            using var response = await client.GetAsync($"repos/{owner}/{repo}/issues/{number}");
            if (!response.IsSuccessStatusCode) return null;

            using var doc = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            var root = doc.RootElement;

            string? milestone = null;
            if (root.TryGetProperty("milestone", out var ms) && ms.ValueKind == JsonValueKind.Object
                && ms.TryGetProperty("title", out var mt))
                milestone = mt.GetString();

            int? commentCount = null;
            if (root.TryGetProperty("comments", out var cc))
                commentCount = cc.GetInt32();

            return new WorkItemDetails(Milestone: milestone, CommentCount: commentCount);
        }
        catch
        {
            return null;
        }
    }

    private async Task<string?> FetchPrDescriptionAsync(PullRequest pr)
    {
        if (pr.Url is null) return null;
        if (!Uri.TryCreate(pr.Url, UriKind.Absolute, out var uri)) return null;

        var path = uri.AbsolutePath.TrimStart('/');
        var gitIdx = path.IndexOf("/_git/", StringComparison.Ordinal);
        var prIdx = path.IndexOf("/pullrequest/", StringComparison.Ordinal);
        if (gitIdx < 0 || prIdx < 0) return null;
        if (!int.TryParse(path[(prIdx + "/pullrequest/".Length)..].Split('/')[0], out var prId)) return null;

        var beforeGit = path[..gitIdx];
        var project = Uri.UnescapeDataString(beforeGit[(beforeGit.LastIndexOf('/') + 1)..]);
        var repo = Uri.UnescapeDataString(path[(gitIdx + "/_git/".Length)..prIdx]);
        var orgUrl = uri.Host == "dev.azure.com"
            ? $"{uri.Scheme}://{uri.Host}/{beforeGit[..beforeGit.IndexOf('/')]}"
            : $"{uri.Scheme}://{uri.Host}";

        var token = TokenStore.GetLinkedAccounts().MicrosoftAccounts
            .FirstOrDefault(a => string.Equals(
                a.OrgUrl.TrimEnd('/'), orgUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase));
        if (token is null) return null;

        try
        {
            var connection = new VssConnection(new Uri(orgUrl), new VssBasicCredential(string.Empty, token.PersonalAccessToken));
            var client = await connection.GetClientAsync<GitHttpClient>();
            var full = await client.GetPullRequestAsync(project, repo, prId);
            return full.Description;
        }
        catch
        {
            return null;
        }
    }

    private async Task<PullRequest?> AssignSelfAsReviewerAsync(PullRequest pr)
    {
        try
        {
            var updated = pr.Provider switch
            {
                Nexus.Models.DataProvider.GitHub => await AssignGitHubSelfAsReviewerAsync(pr),
                Nexus.Models.DataProvider.AzureDevOps => await AssignAdoSelfAsReviewerAsync(pr),
                _ => throw new InvalidOperationException("Unsupported pull request provider.")
            };

            await RefreshAsync();
            MarkPullRequestAsUserAssociated(updated);
            await InvokeAsync(StateHasChanged);
            Snackbar.Add("Assigned you as a reviewer.", Severity.Success);
            return updated;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not assign you as a reviewer: {ex.Message}", Severity.Error);
            return null;
        }
    }

    private void MarkPullRequestAsUserAssociated(PullRequest updated)
    {
        _assignedPrIds.Add(updated.Id);
        _pullRequests = _pullRequests
            .Select(pr => pr.Id == updated.Id ? updated : pr)
            .ToList();
    }

    private async Task<PullRequest> AssignGitHubSelfAsReviewerAsync(PullRequest pr)
    {
        if (!TryParseGitHubPrUrl(pr, out var location))
            throw new InvalidOperationException("Could not determine the GitHub pull request.");

        var repoFullName = $"{location.Owner}/{location.Repo}";
        var token = TokenStore.GetLinkedAccounts().GitHubAccounts
            .FirstOrDefault(a => a.MonitoredRepos.Any(r => r.Equals(repoFullName, StringComparison.OrdinalIgnoreCase)))
            ?? TokenStore.GetLinkedAccounts().GitHubAccounts.FirstOrDefault();
        if (token is null)
            throw new InvalidOperationException("No linked GitHub account can access this pull request.");

        var client = HttpClientFactory.CreateClient("GitHub");
        client.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token.PersonalAccessToken);

        var url = $"repos/{Uri.EscapeDataString(location.Owner)}/{Uri.EscapeDataString(location.Repo)}/pulls/{location.PullRequestNumber}/requested_reviewers";
        using var response = await client.PostAsJsonAsync(url, new { reviewers = new[] { token.Login } });
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await ReadErrorAsync(response));

        return WithSelfReviewer(pr, string.IsNullOrWhiteSpace(token.DisplayName) ? token.Login : token.DisplayName, token.AvatarUrl);
    }

    private async Task<PullRequest> AssignAdoSelfAsReviewerAsync(PullRequest pr)
    {
        var accounts = TokenStore.GetLinkedAccounts().MicrosoftAccounts;
        if (!TryParseAdoPrUrl(pr, accounts, out var location))
            throw new InvalidOperationException("Could not determine the Azure DevOps pull request.");

        var token = accounts.FirstOrDefault(a => string.Equals(
                a.OrgUrl.TrimEnd('/'), location.OrgUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase))
            ?? accounts.FirstOrDefault(a => pr.Url?.StartsWith(a.OrgUrl.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase) == true);
        if (token is null)
            throw new InvalidOperationException("No linked Azure DevOps account can access this pull request.");

        var client = HttpClientFactory.CreateClient();
        client.DefaultRequestHeaders.UserAgent.ParseAdd("Nexus/1.0");
        client.DefaultRequestHeaders.Accept.ParseAdd("application/json");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(
            "Basic", Convert.ToBase64String(System.Text.Encoding.ASCII.GetBytes($":{token.PersonalAccessToken}")));

        var connData = await client.GetFromJsonAsync<AdoConnectionDataDto>(
            $"{location.OrgUrl.TrimEnd('/')}/_apis/connectionData?connectOptions=1&api-version=7.2-preview.1");
        var user = connData?.AuthenticatedUser
            ?? throw new InvalidOperationException("Could not resolve your Azure DevOps identity.");

        var uniqueName = user.Properties?.Account?.Value ?? token.Login;
        var reviewerId = user.Id ?? user.SubjectDescriptor ?? uniqueName;
        if (string.IsNullOrWhiteSpace(reviewerId))
            throw new InvalidOperationException("Could not resolve your Azure DevOps identity ID.");

        var url = $"{location.OrgUrl.TrimEnd('/')}/{Uri.EscapeDataString(location.Project)}/_apis/git/repositories/{Uri.EscapeDataString(location.Repo)}/pullRequests/{location.PullRequestId}/reviewers/{Uri.EscapeDataString(reviewerId)}?api-version=7.2-preview.1";
        using var response = await client.PutAsJsonAsync(url, new
        {
            id = reviewerId,
            uniqueName,
            displayName = user.ProviderDisplayName ?? token.DisplayName,
            vote = 0,
            isRequired = true
        });
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await ReadErrorAsync(response));

        return WithSelfReviewer(pr, string.IsNullOrWhiteSpace(token.DisplayName) ? uniqueName : token.DisplayName, null);
    }

    private static PullRequest WithSelfReviewer(PullRequest pr, string name, string? avatarUrl)
    {
        var reviewer = new ReviewerReference(new UserReference(name, avatarUrl), ReviewerVote.None);
        return pr with
        {
            Reviewers = pr.Reviewers.Concat([reviewer]).ToList(),
            IsAssignedToCurrentUser = true
        };
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body))
            return $"{(int)response.StatusCode} {response.ReasonPhrase}";

        return body.Length > 300 ? body[..300] : body;
    }

    private static bool TryParseGitHubPrUrl(PullRequest pr, out GitHubPrLocation location)
    {
        location = new GitHubPrLocation("", "", 0);
        if (pr.Url is null || !Uri.TryCreate(pr.Url, UriKind.Absolute, out var uri)) return false;
        if (!uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase)) return false;

        var segments = uri.AbsolutePath.Trim('/').Split('/');
        if (segments.Length < 4 || !segments[2].Equals("pull", StringComparison.OrdinalIgnoreCase)) return false;
        if (!int.TryParse(segments[3], out var number)) return false;

        location = new GitHubPrLocation(
            Uri.UnescapeDataString(segments[0]),
            Uri.UnescapeDataString(segments[1]),
            number);
        return true;
    }

    private static bool TryParseAdoPrUrl(PullRequest pr, IEnumerable<MicrosoftAccountToken> accounts, out AdoPrLocation location)
    {
        location = new AdoPrLocation("", "", "", 0);
        if (pr.Url is null || !Uri.TryCreate(pr.Url, UriKind.Absolute, out var uri)) return false;

        var path = uri.AbsolutePath.TrimStart('/');
        var gitIdx = path.IndexOf("/_git/", StringComparison.OrdinalIgnoreCase);
        var prIdx = path.IndexOf("/pullrequest/", StringComparison.OrdinalIgnoreCase);
        if (gitIdx < 0 || prIdx < 0 || prIdx <= gitIdx) return false;
        if (!int.TryParse(path[(prIdx + "/pullrequest/".Length)..].Split('/')[0], out var prId)) return false;

        var beforeGit = path[..gitIdx];
        var repo = Uri.UnescapeDataString(path[(gitIdx + "/_git/".Length)..prIdx]);
        string orgUrl;
        string projectPath;

        if (uri.Host.Equals("dev.azure.com", StringComparison.OrdinalIgnoreCase))
        {
            var slashIdx = beforeGit.IndexOf('/');
            if (slashIdx < 0) return false;
            orgUrl = $"{uri.Scheme}://dev.azure.com/{beforeGit[..slashIdx]}";
            projectPath = beforeGit[(slashIdx + 1)..];
        }
        else
        {
            var matchingAccount = accounts
                .Where(a => !string.IsNullOrWhiteSpace(a.OrgUrl)
                    && pr.Url.StartsWith(a.OrgUrl.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(a => a.OrgUrl.Length)
                .FirstOrDefault();

            if (matchingAccount is not null)
            {
                orgUrl = matchingAccount.OrgUrl.TrimEnd('/');
                projectPath = StripOrgPath(beforeGit, orgUrl);
            }
            else
            {
                orgUrl = $"{uri.Scheme}://{uri.Host}";
                projectPath = beforeGit.Contains('/') ? beforeGit[(beforeGit.LastIndexOf('/') + 1)..] : beforeGit;
            }
        }

        if (string.IsNullOrWhiteSpace(projectPath) || string.IsNullOrWhiteSpace(repo)) return false;
        location = new AdoPrLocation(orgUrl, Uri.UnescapeDataString(projectPath), repo, prId);
        return true;
    }

    private static string StripOrgPath(string pathBeforeGit, string orgUrl)
    {
        if (!Uri.TryCreate(orgUrl.TrimEnd('/') + "/", UriKind.Absolute, out var orgUri))
            return pathBeforeGit;

        var orgPath = orgUri.AbsolutePath.Trim('/');
        if (!string.IsNullOrEmpty(orgPath)
            && pathBeforeGit.StartsWith(orgPath + "/", StringComparison.OrdinalIgnoreCase))
            return pathBeforeGit[(orgPath.Length + 1)..];

        return pathBeforeGit.Contains('/') ? pathBeforeGit[(pathBeforeGit.LastIndexOf('/') + 1)..] : pathBeforeGit;
    }

    private record GitHubPrLocation(string Owner, string Repo, int PullRequestNumber);

    private record AdoPrLocation(string OrgUrl, string Project, string Repo, int PullRequestId);

    private record AdoConnectionDataDto(
        [property: JsonPropertyName("authenticatedUser")] AdoConnectionUserDto? AuthenticatedUser);

    private record AdoConnectionUserDto(
        [property: JsonPropertyName("id")] string? Id,
        [property: JsonPropertyName("providerDisplayName")] string? ProviderDisplayName,
        [property: JsonPropertyName("subjectDescriptor")] string? SubjectDescriptor,
        [property: JsonPropertyName("properties")] AdoConnectionUserPropertiesDto? Properties);

    private record AdoConnectionUserPropertiesDto(
        [property: JsonPropertyName("Account")] AdoConnectionUserPropertyValueDto? Account);

    private record AdoConnectionUserPropertyValueDto(
        [property: JsonPropertyName("$value")] string? Value);

    public void Dispose()
    {
        TokenStore.AccountsChanged -= OnAccountsChanged;
        _cts.Cancel();
    }
}
